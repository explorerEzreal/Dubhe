# 本地开发环境（仅本机使用，与线上无关）。复制为 .env.local 后运行 pnpm dev:local。
# 前提：本机 PostgreSQL 已创建 dubhe_dev 数据库（如 createdb dubhe_dev），迁移只建表、不建库。

# 本地 PostgreSQL（宿主机服务，非 Docker；按本机实际账号/密码修改）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dubhe_dev

# 本地密钥（与线上密钥不同；至少 32 字符）
JWT_SECRET=local-dev-jwt-secret-at-least-32-characters
API_KEY_PEPPER=local-dev-api-pepper-at-least-32-characters

# 本地 Cloud 地址（Cloud 监听 3000）
PUBLIC_BASE_URL=http://localhost:3000
# 本地 Web 地址（Vite 监听 5173）
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# 本地关闭 TLS 要求（模型设备 Agent 用 ws:// 直连）
AGENT_REQUIRE_TLS=false
TRUST_PROXY=false
