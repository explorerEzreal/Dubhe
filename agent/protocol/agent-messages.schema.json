{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentMessage",
  "type": "object",
  "required": ["protocol_version", "type", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": 1 },
    "type": {
      "enum": [
        "register", "registered",
        "heartbeat", "heartbeat_ack",
        "infer_request", "infer_chunk", "infer_done", "infer_error", "infer_cancel"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "request_id": { "type": "string" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "heartbeat" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["status", "models"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["online", "degraded"] },
              "hardwareInfo": {
                "type": ["object", "null"]
              },
              "models": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": ["name", "state"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                    },
                    "state": {
                      "enum": [
                        "unknown", "checking", "pulling", "ready",
                        "busy", "error", "stopped", "offline"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "infer_request" } }, "required": ["type"] },
      "then": {
        "required": ["request_id"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["model", "messages", "stream"],
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
              "messages": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "required": ["role", "content"], "additionalProperties": false, "properties": { "role": { "enum": ["system", "user", "assistant"] }, "content": { "type": "string", "minLength": 1, "maxLength": 1000000 } } } },
              "stream": { "type": "boolean" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
              "max_tokens": { "type": "integer", "minimum": 1, "maximum": 100000 },
              "stop": { "oneOf": [{ "type": "string" }, { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } }] },
              "presence_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
              "frequency_penalty": { "type": "number", "minimum": -2, "maximum": 2 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "infer_chunk" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["seq", "content"], "additionalProperties": false, "properties": { "seq": { "type": "integer", "minimum": 0 }, "content": { "type": "string" }, "usage": { "type": "object", "required": ["prompt_tokens", "completion_tokens", "total_tokens"], "additionalProperties": false, "properties": { "prompt_tokens": { "type": "integer", "minimum": 0 }, "completion_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 } } } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_done" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["content"], "additionalProperties": false, "properties": { "content": { "type": "string" }, "finish_reason": { "const": "stop" }, "usage": { "type": "object", "required": ["prompt_tokens", "completion_tokens", "total_tokens"], "additionalProperties": false, "properties": { "prompt_tokens": { "type": "integer", "minimum": 0 }, "completion_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 } } } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_error" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["code"], "additionalProperties": false, "properties": { "code": { "enum": ["MODEL_NOT_READY", "MODEL_NOT_FOUND", "OLLAMA_UNAVAILABLE", "INFERENCE_TIMEOUT", "UPSTREAM_ERROR", "CONCURRENCY_LIMIT"] }, "message": { "type": "string", "maxLength": 500 } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_cancel" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } }
    }
  ]
}
