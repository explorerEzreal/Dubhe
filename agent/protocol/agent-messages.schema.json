{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentMessage",
  "type": "object",
  "required": ["protocol_version", "type", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": 1 },
    "type": {
      "enum": [
        "register", "registered",
        "heartbeat", "heartbeat_ack",
        "infer_request", "infer_chunk", "infer_done", "infer_error", "infer_cancel"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "request_id": { "type": "string" },
    "payload": { "type": "object" }
  },
  "definitions": {
    "cpuMetrics": { "type": "object", "properties": { "cores": { "type": "integer", "minimum": 1 }, "loadAverage": { "type": "array", "items": { "type": "number", "minimum": 0 } }, "usagePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } }, "additionalProperties": true },
    "memoryMetrics": { "type": "object", "properties": { "totalBytes": { "type": "number", "minimum": 0 }, "freeBytes": { "type": "number", "minimum": 0 }, "usedBytes": { "type": "number", "minimum": 0 }, "usagePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } }, "additionalProperties": true },
    "gpuMetrics": { "type": "object", "properties": { "vendor": { "type": "string" }, "model": { "type": "string" }, "usagePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "memoryTotalBytes": { "type": "number", "minimum": 0 }, "memoryUsedBytes": { "type": "number", "minimum": 0 } }, "additionalProperties": true },
    "diskMetrics": { "type": "object", "properties": { "mount": { "type": "string" }, "totalBytes": { "type": "number", "minimum": 0 }, "freeBytes": { "type": "number", "minimum": 0 }, "usedBytes": { "type": "number", "minimum": 0 }, "usagePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } }, "additionalProperties": true },
    "networkMetrics": { "type": "object", "properties": { "rxBytes": { "type": "number", "minimum": 0 }, "txBytes": { "type": "number", "minimum": 0 }, "rxBytesPerSecond": { "type": ["number", "null"], "minimum": 0 }, "txBytesPerSecond": { "type": ["number", "null"], "minimum": 0 } }, "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "heartbeat" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["status", "models"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["online", "degraded"] },
              "hardwareInfo": {
                "type": ["object", "null"],
                "properties": {
                  "cpu": { "$ref": "#/definitions/cpuMetrics" },
                  "memory": { "$ref": "#/definitions/memoryMetrics" },
                  "gpu": { "oneOf": [{ "$ref": "#/definitions/gpuMetrics" }, { "type": "null" }] },
                  "disk": { "oneOf": [{ "$ref": "#/definitions/diskMetrics" }, { "type": "null" }] },
                  "network": { "oneOf": [{ "$ref": "#/definitions/networkMetrics" }, { "type": "null" }] }
                },
                "additionalProperties": true
              },
              "models": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": ["name", "state"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                    },
                    "state": {
                      "enum": [
                        "unknown", "checking", "pulling", "ready",
                        "busy", "error", "stopped", "offline"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "infer_request" } }, "required": ["type"] },
      "then": {
        "required": ["request_id"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["endpoint", "model", "body", "stream", "request_bytes"],
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
              "endpoint": { "enum": ["chat/completions", "responses"] },
              "body": { "type": "object", "additionalProperties": true },
              "stream": { "type": "boolean" },
              "request_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "infer_chunk" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["seq", "data", "encoding", "response_bytes"], "additionalProperties": false, "properties": { "seq": { "type": "integer", "minimum": 0 }, "data": { "type": "string" }, "encoding": { "const": "base64" }, "response_bytes": { "type": "integer", "minimum": 0 }, "status_code": { "type": "integer", "minimum": 100, "maximum": 599 }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "usage": { "type": "object", "required": ["prompt_tokens", "completion_tokens", "total_tokens"], "additionalProperties": false, "properties": { "prompt_tokens": { "type": "integer", "minimum": 0 }, "completion_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 } } } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_done" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["status_code", "headers", "response_bytes"], "additionalProperties": false, "properties": { "status_code": { "type": "integer", "minimum": 100, "maximum": 599 }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "body": { "type": "string" }, "encoding": { "const": "base64" }, "response_bytes": { "type": "integer", "minimum": 0 }, "finish_reason": { "type": "string" }, "usage": { "type": "object", "required": ["prompt_tokens", "completion_tokens", "total_tokens"], "additionalProperties": false, "properties": { "prompt_tokens": { "type": "integer", "minimum": 0 }, "completion_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 } } } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_error" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "required": ["code"], "additionalProperties": false, "properties": { "code": { "enum": ["MODEL_NOT_READY", "MODEL_NOT_FOUND", "LOCAL_SERVICE_UNAVAILABLE", "INFERENCE_TIMEOUT", "UPSTREAM_ERROR", "CONCURRENCY_LIMIT"] }, "message": { "type": "string", "maxLength": 500 } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "infer_cancel" } }, "required": ["type"] },
      "then": { "required": ["request_id"], "properties": { "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } }
    }
  ]
}
