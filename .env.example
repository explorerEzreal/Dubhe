# 对外访问域名，必须已解析到本服务器并开放 80/443。
PUBLIC_DOMAIN=console.example.com

POSTGRES_USER=cloud
POSTGRES_DB=cloud
# 生产环境请替换为随机强密码，不要提交真实凭证。
POSTGRES_PASSWORD=请替换为随机强密码
# 可使用：openssl rand -hex 32
JWT_SECRET=请使用openssl-rand-hex-32生成
API_KEY_PEPPER=请使用openssl-rand-hex-32生成

# .env 仅供 Docker Compose 读取，请限制权限：chmod 600 .env
# 密钥轮换后需重启 Cloud；已暴露的密钥必须立即作废并重新生成。

# 可选：配置后首次启动自动创建管理员；留空则通过 Web 注册。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请替换为管理员强密码
# 超级管理员仅通过部署环境 Secret 注入，不要提交真实密码。
SUPER_ADMIN_EMAIL=supershiba@77.com
SUPER_ADMIN_PASSWORD=请替换为超级管理员密码
