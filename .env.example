# 对外访问域名，必须已解析到本服务器并开放 80/443。
PUBLIC_DOMAIN=console.example.com

POSTGRES_USER=cloud
POSTGRES_DB=cloud
POSTGRES_PASSWORD=请替换为随机强密码
JWT_SECRET=请替换为至少32字符的随机密钥
API_KEY_PEPPER=请替换为至少32字符的随机密钥

# 可选：配置后首次启动自动创建管理员；留空则通过 Web 注册。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请替换为管理员强密码

AGENT_RELEASE_VERSION=0.1.0




