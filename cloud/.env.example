PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://cloud:cloud@localhost:5432/cloud
JWT_SECRET=replace-with-at-least-32-characters
API_KEY_PEPPER=replace-with-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
WEB_BASE_URL=http://localhost:5173
AGENT_DOWNLOAD_URL=http://localhost:3000/downloads/agent
AGENT_RELEASE_DIR=./releases
AGENT_RELEASE_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173
AGENT_WS_PATH=/agent
AGENT_REQUIRE_TLS=true
AGENT_MAX_MESSAGE_BYTES=1048576
AGENT_HEARTBEAT_TIMEOUT_MS=30000
TRUST_PROXY=false
LOG_LEVEL=info
SESSION_TTL_SECONDS=3600
ENROLLMENT_TOKEN_TTL_SECONDS=900
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
INFERENCE_TIMEOUT_MS=120000
TLS_CERT_DIR=./certs
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
